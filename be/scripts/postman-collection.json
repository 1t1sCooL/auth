    {
      "name": "Users",
      "item": [
        {
          "name": "Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{BASE}}/api/users/profile",
              "host": [
                "{{BASE}}"
              ],
              "path": [
                "api",
                "users",
                "profile"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Change password",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 204) {\r",
                  "    \r",
                  "    const requestData = JSON.parse(pm.request.body.raw);\r",
                  "    const updatedPassword = requestData.newPassword;\r",
                  "\r",
                  "    pm.environment.set(\"password\", updatedPassword);\r",
                  "\r",
                  "    console.log(\"Переменная 'password' успешно обновлена на: \" + updatedPassword);\r",
                  "} else {\r",
                  "    console.warn(\"Пароль не был обновлен, так как запрос завершился с ошибкой: \" + pm.response.code);\r",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"{{password}}\",\n  \"newPassword\": \"{{newPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{BASE}}/api/users/password",
              "host": [
                "{{BASE}}"
              ],
              "path": [
                "api",
                "users",
                "password"
              ]
            }
          },
          "response": []
        },
