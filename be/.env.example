JWT_SECRET=your_super_secret_key_at_least_32_chars_long

MONGO_URI=mongodb://localhost:27017/authDemo

PORT=3000
EXP_IN=24h
REFRESH_EXP_IN=7d
SALT_ROUNDS=10

# Подтверждение email (mailer)
MAILER_API_URL=http://localhost:4000
MAILER_API_KEY=your-secret-mailer-key
AUTH_PUBLIC_URL=http://localhost:3000
# На локалке без mailer: SKIP_MAIL_SEND=1 — ссылка выводится в консоль
SKIP_MAIL_SEND=1
